# Deployment Environment Configuration for Research AI Runtime
#
# Values marked [production baseline] are the measured settings of the legacy
# gateway currently running on the Unraid UHD730 host. They are the parity
# reference for the legacy -> modular cutover: do not replace them with code
# defaults, which differ for several of these keys.

# ---------------------------------------------------------------- Network & ports
AI_GATEWAY_PORT=28001
OVMS_REST_PORT=28331
RESEARCH_MEDIA_PORT=28003

# ------------------------------------------------------------ Hosts & endpoints
OVMS_BASE=http://ovms-server:8001
AI_GATEWAY_ENDPOINT=http://ai-gateway:8000
# HF mirror: without it the tokenizer fallback download path is unreliable here.
HF_ENDPOINT=https://hf-mirror.com

# ------------------------------------------------------------------------- Paths
OVMS_CONFIG_PATH=/ovms-config/config.json
OVMS_MODEL_CATALOG_PATH=/ovms-config/model_catalog.json
# Authoritative logical model registry for the modular gateway.
MODELS_CONFIG_PATH=/config/models.yaml
# Runtime JSON registry (legacy authority; kept only as a read fallback).
MODEL_REGISTRY_PATH=/ovms-config/model_registry.json
PARSER_CONFIG_PATH=/config/providers.yaml
MEDIA_DATA_DIR=/data/media.lance

# ------------------------------------------------------- OVMS config update mode
# poll: rely on OVMS filesystem polling (default 1s). Preferred, because the
#       global /v1/config/reload endpoint reloads unrelated models and leaves
#       END tombstones behind.
# api:  compatibility mode for deployments that disable polling.
OVMS_CONFIG_UPDATE_MODE=poll
OVMS_TIMEOUT=120

# ------------------------------------------------------------ OVMS image pinning
# NEVER use `openvino/model_server:latest-gpu`. It has already drifted from
# OVMS 2026.1 to 2026.3.1, and 2026.3.1 removes the Classic Model REST API
# (`POST /v1/models/{model}:predict`) that the `tfs` protocol depends on.
# `latest is not a production compatibility contract`.
#
# Pin a validated tag for dev/CI:
#   OVMS_IMAGE=openvino/model_server:2026.1-gpu
# Pin the validated digest for production:
#   OVMS_IMAGE=openvino/model_server@sha256:22f92a1a5ad6784384e47296c43bde239887a623e75de45b0e1802659de416a6
OVMS_IMAGE=openvino/model_server:2026.1-gpu

# ------------------------------------------------------- OVMS wire protocol
# Selects how the gateway talks to OVMS for Classic Model inference:
#   tfs    -> POST /v1/models/{model}:predict   (OVMS 2026.1, current production)
#   kserve -> POST /v2/models/{model}/infer     (OVMS 2026.3.1+; the Classic Model
#                                                REST API was repurposed for
#                                                MediaPipe graphs and no longer
#                                                accepts `{"instances": [...]}`)
#   auto   -> probe the backend once at first use and cache the result.
#             Development / acceptance / CI ONLY. Production must pin `tfs` or
#             `kserve` explicitly so an OVMS upgrade can never silently change
#             the wire protocol. Auto-detection fails closed: if the backend
#             cannot be identified, requests return 502 instead of falling back.
OVMS_PROTOCOL=tfs

# ------------------------------------------- Model lifecycle & broker (baseline)
MODEL_IDLE_UNLOAD_SECONDS=1200
MAX_LOADED_MODELS=2
MODEL_IDLE_SWEEP_SECONDS=60
CPU_SEMAPHORE_LIMIT=4
CPU_THREAD_BUDGET=4
MAX_QUEUE_DEPTH=64
ADAPTIVE_EMBEDDING_BATCHING=1

# --------------------------------------------------------------- Tokenizer paths
BGE_TOKENIZER_PATH=/tokenizers/bge-m3
RERANK_TOKENIZER_PATH=/tokenizers/qwen-reranker
BGE_FALLBACK_TOKENIZER=BAAI/bge-m3
RERANK_FALLBACK_TOKENIZER=Qwen/Qwen3-Reranker-0.6B

# --------------------------------------------------- Rerank settings (baseline)
RERANK_STRICT_RECALL=1
RERANK_MAX_DOCS=64
RERANK_MAX_LENGTH=128
RERANK_MAX_CHARS=1000
RERANK_BATCH_SIZE=1
RERANK_FALLBACK_MAX_LENGTH=96
RERANK_FALLBACK_TIMEOUT=180

# ------------------------------------------------------- BGE settings (baseline)
BGE_MAX_TOTAL_TOKENS=8192
BGE_CHUNK_TOKENS=1024
BGE_CHUNK_OVERLAP=128
BGE_BATCH_SIZE=8

# ------------------------------------------------- Provider secrets & endpoints
MINERU_API_KEY=your_mineru_api_key_here
MINERU_ENDPOINT=https://mineru.net/api/v4

PADDLEOCR_API_KEY=your_paddleocr_api_key_here
PADDLEOCR_ENDPOINT=https://paddleocr.example.com/api

LOCAL_MINERU_ENDPOINT=http://mineru-local:8080
LOCAL_PADDLE_ENDPOINT=http://paddle-local:8080

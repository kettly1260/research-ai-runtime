# Deployment Environment Configuration for Research AI Runtime

# Network & Ports
AI_GATEWAY_PORT=28001
OVMS_REST_PORT=28331
RESEARCH_MEDIA_PORT=28003

# Hosts & Endpoints
OVMS_BASE=http://ovms-server:8001
AI_GATEWAY_ENDPOINT=http://ai-gateway:8000

# Paths
OVMS_CONFIG_PATH=/ovms-config/config.json
OVMS_MODEL_CATALOG_PATH=/ovms-config/model_catalog.json
MODELS_CONFIG_PATH=/config/models.yaml
PARSER_CONFIG_PATH=/config/providers.yaml
MEDIA_DATA_DIR=/data/media.lance

# Model Lifecycle & Broker
MAX_LOADED_MODELS=2
MODEL_IDLE_UNLOAD_SECONDS=600
MODEL_IDLE_SWEEP_SECONDS=60
OVMS_TIMEOUT=120

# Tokenizer paths
BGE_TOKENIZER_PATH=/tokenizers/bge-m3
RERANK_TOKENIZER_PATH=/tokenizers/qwen-reranker

# Provider Secrets & Endpoints
MINERU_API_KEY=your_mineru_api_key_here
MINERU_ENDPOINT=https://mineru.net/api/v4

PADDLEOCR_API_KEY=your_paddle_api_key_here
PADDLEOCR_ENDPOINT=https://paddleocr.example.com/api

LOCAL_MINERU_ENDPOINT=http://mineru-local:8080
LOCAL_PADDLE_ENDPOINT=http://paddle-local:8080

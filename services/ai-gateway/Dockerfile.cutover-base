# Reproducible runtime base for the modular cutover image.
#
# The legacy production image runs Python 3.11.15. Its Python runtime package
# set was captured with `pip freeze` on 2026-09-16 and is reproduced here with
# exact versions. This avoids transferring private registry credentials or
# local Docker layers from the Unraid host to GitHub.

ARG PYTHON_BASE_IMAGE=python:3.11.15
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

COPY services/ai-gateway/requirements.cutover-base.txt /tmp/requirements.cutover-base.txt

RUN python -m pip install --no-cache-dir -r /tmp/requirements.cutover-base.txt \
    && python -m pip check

LABEL org.opencontainers.image.source="https://github.com/kettly1260/research-ai-runtime"
LABEL org.opencontainers.image.description="Pinned legacy ai-gateway Python runtime for the modular cutover"

CMD ["python"]
